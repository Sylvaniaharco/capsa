{
  // Worker capsa: file statis game (hasil `npm run build` di dist) + API meja online di /games/capsa/api/*.
  // Game disajikan di sylvaniaharco.com/games/capsa/ (pola yang sama dengan games-mahjong0hk).
  // Nama harus sama dengan nama Worker di Cloudflare (yang tersambung ke repo ini).
  "name": "capsa",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/games/capsa/api/*"]
  },
  "routes": [
    { "pattern": "sylvaniaharco.com/games/capsa*", "zone_name": "sylvaniaharco.com" },
    // Halaman depan semua game (hub/index.html → dist/games/index.html). Hanya dua alamat persis ini, bukan /games/*
    // (game lain punya Worker sendiri: mahjonghk, domracer).
    { "pattern": "sylvaniaharco.com/games", "zone_name": "sylvaniaharco.com" },
    { "pattern": "sylvaniaharco.com/games/", "zone_name": "sylvaniaharco.com" }
  ],
  // Meja online: satu Durable Object per kode meja (SQLite bawaan); pencari meja Ranked: satu global
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "CapsaRoom" },
      { "name": "LOBBY", "class_name": "CapsaLobby" }
    ]
  },
  // Akun & koin ada di Worker Mahjong. Ranked memanggilnya lewat service binding ke entrypoint CapsaGate
  // (tukar tiket jadi data pemain, selesaikan koin per ronde). Worker Mahjong harus sudah ter-deploy dengan CapsaGate.
  "services": [{ "binding": "MAHJONG", "service": "games-mahjong0hk", "entrypoint": "CapsaGate" }],
  // Tambah class DO baru = tambah tag migrasi baru, jangan ubah yang lama.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CapsaRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["CapsaLobby"] }
  ]
}
